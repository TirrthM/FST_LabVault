# ─────────────────────────────────────────────────────────────────
# LabVault Environment Configuration (.env.example)
# ─────────────────────────────────────────────────────────────────

# Database (PostgreSQL with Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labvault?schema=public"

# Authentication Session Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET="labvault-super-secure-production-auth-secret-change-in-prod"

# Resend Transactional Email API Key
# Sign up at https://resend.com to get your API key
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Verified Sender Email Address in Resend
RESEND_FROM_EMAIL="LabVault Notifications <notifications@labvault.edu>"

# Resend Webhook Signing Secret (from Resend Webhooks Dashboard)
# Used to verify incoming webhook signatures in /api/webhooks/resend
RESEND_WEBHOOK_SECRET="whsec_abcdefghijklmnopqrstuvwxyz123456"

# Next.js Public App URL (for absolute links in emails and OG images)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
